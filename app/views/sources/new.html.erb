<% content_for :title, "Add Source — Sigsift" %>

<div class="mb-6">
  <nav class="text-sm text-gray-500 mb-2">
    <%= link_to "Opportunities", opportunities_path, class: "hover:text-gray-700" %> /
    <%= link_to @opportunity.name, @opportunity, class: "hover:text-gray-700" %> /
    <span class="text-gray-900">Add source</span>
  </nav>
  <h1 class="text-2xl font-bold text-gray-900">Add Source</h1>
</div>

<div class="bg-white rounded-lg border border-gray-200 p-6 max-w-2xl">
  <%= render "form", opportunity: @opportunity, source: @source %>
</div>
