<%= form_with model: [ opportunity, source ], class: "space-y-6" do |f| %>
  <% if source.errors.any? %>
    <div class="rounded-md bg-red-50 border border-red-200 p-4">
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% source.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "e.g. DOTD Public Bid Listings" %>
  </div>

  <div>
    <%= f.label :url, "URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :url, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "https://..." %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 3, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "What is this source? e.g. State DOT public bid listings for Louisiana" %>
  </div>

  <div>
    <%= f.label :notes, "Agent instructions", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <p class="text-xs text-gray-500 mb-2">Optional hints for the AI about how to use this source.</p>
    <%= f.text_area :notes, rows: 3, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "e.g. This is an index page. Find links to individual bid notices and check each one." %>
  </div>

  <div>
    <%= f.label :scan_frequency_days, "Scan every (days)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :scan_frequency_days, min: 1, class: "block w-32 rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :status, Source.statuses.keys.map { |s| [s.capitalize, s] }, {}, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 text-sm font-medium text-white hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "Cancel", @opportunity, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
