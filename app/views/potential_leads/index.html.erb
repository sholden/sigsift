<% content_for :title, "Review Queue — Sigsift" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Review Queue</h1>
  <p class="mt-1 text-sm text-gray-500">
    <% if @potential_leads.empty? %>
      Nothing to review right now.
    <% else %>
      <%= @potential_leads.count %> <%= "finding".pluralize(@potential_leads.count) %> waiting for review.
    <% end %>
  </p>
</div>

<% if @potential_leads.empty? %>
  <div class="text-center py-16 bg-white rounded-lg border border-gray-200">
    <p class="text-gray-500 text-sm">All caught up. No pending findings.</p>
  </div>
<% else %>
  <div class="space-y-4" id="potential-leads">
    <% @potential_leads.each do |pl| %>
      <%= render "potential_lead", potential_lead: pl %>
    <% end %>
  </div>
<% end %>
