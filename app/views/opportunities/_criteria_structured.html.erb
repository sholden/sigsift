<div id="criteria_structured" class="mb-6">
  <% data = opportunity.criteria_structured_data %>
  <% if data.blank? %>
    <div class="bg-white border border-dashed border-gray-300 rounded-lg p-4">
      <p class="text-xs font-semibold text-gray-500 mb-1">Structured criteria</p>
      <p class="inline-flex items-center gap-1.5 text-sm text-gray-500">
        <svg class="animate-spin h-3.5 w-3.5" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        Extracting criteria…
      </p>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-4">
      <p class="text-xs font-semibold text-gray-500 mb-2">Structured criteria</p>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 text-sm">
        <% data.each do |key, value| %>
          <% next if value.blank? || (value.respond_to?(:empty?) && value.empty?) %>
          <div>
            <dt class="text-xs uppercase tracking-wide text-gray-400"><%= key.to_s.humanize %></dt>
            <dd class="text-gray-900">
              <% if value.is_a?(Array) %>
                <%= value.join(", ") %>
              <% else %>
                <%= value %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>
</div>
