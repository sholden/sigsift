<% content_for :title, "#{@lead.title} — Sigsift" %>

<div class="mb-6">
  <nav class="text-sm text-gray-500 mb-2">
    <%= link_to "Leads", leads_path, class: "hover:text-gray-700" %> /
    <span class="text-gray-900"><%= @lead.title %></span>
  </nav>
  <div class="flex items-start justify-between">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <h1 class="text-2xl font-bold text-gray-900"><%= @lead.title %></h1>
        <%= lead_status_badge(@lead.status) %>
        <%= lead_priority_badge(@lead.priority) if @lead.priority.present? %>
      </div>
      <p class="text-sm text-gray-500"><%= @lead.opportunity.name %></p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_lead_path(@lead), class: "inline-flex items-center px-3 py-1.5 rounded-md border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
      <%= button_to "Archive", @lead, method: :delete, data: { turbo_confirm: "Archive this lead?" }, class: "inline-flex items-center px-3 py-1.5 rounded-md border border-gray-200 text-sm font-medium text-gray-500 hover:bg-gray-50" %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2 space-y-6">
    <% if @lead.description.present? %>
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <h2 class="text-sm font-semibold text-gray-700 mb-2">Description</h2>
        <p class="text-sm text-gray-900 whitespace-pre-wrap"><%= @lead.description %></p>
      </div>
    <% end %>

    <% if @lead.notes.present? %>
      <div class="bg-white rounded-lg border border-gray-200 p-5">
        <h2 class="text-sm font-semibold text-gray-700 mb-2">Notes</h2>
        <p class="text-sm text-gray-900 whitespace-pre-wrap"><%= @lead.notes %></p>
      </div>
    <% end %>

    <% if @lead.potential_lead.present? %>
      <div class="bg-gray-50 rounded-lg border border-gray-200 p-5">
        <h2 class="text-sm font-semibold text-gray-700 mb-3">Found by agent</h2>
        <p class="text-xs text-gray-500">Source: <%= link_to @lead.potential_lead.source.name, opportunity_source_path(@lead.opportunity, @lead.potential_lead.source), class: "text-indigo-600 hover:underline" %></p>
        <% if @lead.potential_lead.source_url.present? %>
          <a href="<%= @lead.potential_lead.source_url %>" target="_blank" rel="noopener" class="text-xs text-indigo-600 hover:underline block mt-1"><%= @lead.potential_lead.source_url %></a>
        <% end %>
        <% detections = @lead.potential_lead.lead_detections.includes(:scan_run).order(created_at: :desc) %>
        <% if detections.any? %>
          <div class="mt-3 space-y-2">
            <p class="text-xs font-medium text-gray-500">Detection history (<%= detections.count %> times)</p>
            <% detections.each do |detection| %>
              <div class="text-xs text-gray-600">
                <span class="text-gray-400"><%= detection.created_at.strftime("%b %-d, %Y") %></span>
                — <%= detection.description %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="space-y-4">
    <div class="bg-white rounded-lg border border-gray-200 p-5">
      <h2 class="text-sm font-semibold text-gray-700 mb-3">Details</h2>
      <dl class="space-y-3">
        <% if @lead.client_name.present? %>
          <div>
            <dt class="text-xs text-gray-400">Client</dt>
            <dd class="text-sm text-gray-900"><%= @lead.client_name %></dd>
          </div>
        <% end %>
        <% if @lead.contact_name.present? %>
          <div>
            <dt class="text-xs text-gray-400">Contact</dt>
            <dd class="text-sm text-gray-900"><%= @lead.contact_name %></dd>
            <% if @lead.contact_email.present? %>
              <dd class="text-xs text-indigo-600"><%= mail_to @lead.contact_email %></dd>
            <% end %>
            <% if @lead.contact_phone.present? %>
              <dd class="text-xs text-gray-500"><%= @lead.contact_phone %></dd>
            <% end %>
          </div>
        <% end %>
        <% if @lead.deadline.present? %>
          <div>
            <dt class="text-xs text-gray-400">Deadline</dt>
            <dd class="text-sm <%= @lead.deadline < Date.current ? 'text-red-600 font-medium' : 'text-gray-900' %>"><%= @lead.deadline.strftime("%B %-d, %Y") %></dd>
          </div>
        <% end %>
        <% if @lead.estimated_budget_cents.present? %>
          <div>
            <dt class="text-xs text-gray-400">Budget</dt>
            <dd class="text-sm text-gray-900"><%= @lead.budget_display %></dd>
          </div>
        <% end %>
        <% if @lead.time_horizon.present? %>
          <div>
            <dt class="text-xs text-gray-400">Time horizon</dt>
            <dd class="text-sm text-gray-900"><%= @lead.time_horizon %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</div>
