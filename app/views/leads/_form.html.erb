<%= form_with model: lead, class: "space-y-6" do |f| %>
  <% if lead.errors.any? %>
    <div class="rounded-md bg-red-50 border border-red-200 p-4">
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% lead.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :opportunity_id, "Opportunity", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :opportunity_id, @opportunities, :id, :name, { prompt: "Select an opportunity" }, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "e.g. Baton Rouge Community College Roof Replacement" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :status, Lead.statuses.keys.map { |s| [s.humanize.gsub("New lead", "New"), s] }, {}, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :priority, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :priority, Lead.priorities.keys.map { |p| [p.capitalize, p] }, { include_blank: "— none —" }, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <%= f.label :client_name, "Client / Organization", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :client_name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :contact_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :contact_name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <%= f.label :contact_email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :contact_email, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :contact_phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.phone_field :contact_phone, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
    <div>
      <%= f.label :deadline, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :deadline, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :estimated_budget_cents, "Budget (cents)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :estimated_budget_cents, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "e.g. 200000000 = $2M" %>
    </div>
    <div>
      <%= f.label :time_horizon, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :time_horizon, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500", placeholder: "e.g. Q3 2026" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 4, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 text-sm font-medium text-white hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "Cancel", leads_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
