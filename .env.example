# Copy to .env (gitignored) and fill in values for local development.

# Anthropic API key — required for criteria extraction and the scanning agent.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=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

# Optional: override the default agent model (haiku-4-5).
# Useful when iterating with bin/scan; can also pass --model on the CLI.
# AGENT_MODEL=claude-sonnet-4-6

# Optional: override the Playwright CLI path. Defaults to node_modules/.bin/playwright
# if present, otherwise resolves via `which playwright` or `npx playwright`.
# PLAYWRIGHT_CLI_EXECUTABLE_PATH=
